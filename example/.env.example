# Where the app asks for a payment session. This is YOUR server in a real app
# (it holds the sk_ key). The public demo uses PayBridgeNP's own demo endpoint.
EXPO_PUBLIC_PAYBRIDGE_DEMO_API=https://paybridgenp.com/api/demo/mobile-session
# Publishable key for the demo merchant (sandbox). Safe to ship in an app.
EXPO_PUBLIC_PAYBRIDGE_PUBLISHABLE_KEY=pk_test_...
# Optional: point the SDK at another API (staging / local). Defaults to production.
# EXPO_PUBLIC_PAYBRIDGE_API_BASE=https://api.paybridgenp.com
